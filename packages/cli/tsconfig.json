{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    // The CLI is bundled by tsup/esbuild, so resolve modules the way the bundler
    // does — this also handles `export default` from CJS-only deps (ignore, tar).
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["src"]
}
