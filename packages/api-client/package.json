{
  "name": "@roxyon/api-client",
  "version": "0.1.0",
  "description": "Typed client for the Roxyon BaaS (RX engine) and the Roxyon Applications deploy API.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "tsup"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bea-technology/roxyon-devtools.git",
    "directory": "packages/api-client"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
