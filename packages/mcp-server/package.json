{
  "name": "@roxyon/mcp",
  "mcpName": "io.github.bea-technology/roxyon",
  "version": "1.0.0",
  "description": "Model Context Protocol server for Roxyon — lets any MCP-capable AI assistant build with LumenJS, use the Roxyon BaaS, and deploy to Roxyon infrastructure.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "roxyon-mcp": "./bin/roxyon-mcp.js"
  },
  "files": ["dist", "bin", "resources", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node bin/roxyon-mcp.js",
    "prepublishOnly": "tsup"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["mcp", "modelcontextprotocol", "roxyon", "lumenjs", "deploy", "baas"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bea-technology/roxyon-devtools.git",
    "directory": "packages/mcp-server"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@roxyon/api-client": "workspace:*",
    "@roxyon/deploy-core": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
